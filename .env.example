# ── Core ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_hex_chars
SIGNER_VAULT_KEY=replace_with_64_hex_chars
DATABASE_PATH=./data/tide.db

# ── Solana ───────────────────────────────────────────────────────────────────
# A dedicated RPC is REQUIRED for live execution (Helius, Triton, QuickNode, …).
# Public mainnet RPC is intentionally rejected for signing live transactions.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CLUSTER=mainnet-beta
ALLOW_PUBLIC_RPC_LIVE=false

# ── Meteora official indexed data APIs ───────────────────────────────────────
METEORA_DLMM_API=https://dlmm.datapi.meteora.ag
METEORA_DAMM_API=https://damm-v2.datapi.meteora.ag
RUGCHECK_API=https://api.rugcheck.xyz
# Jupiter Lite API — token prices and swap quotes.
JUPITER_API=https://lite-api.jup.ag

# ── Safety ───────────────────────────────────────────────────────────────────
# Paper mode is always the default. Live trading additionally requires:
# this flag + an encrypted execution wallet + a signed, time-boxed user arming.
LIVE_TRADING_ENABLED=false
PAPER_STARTING_BALANCE=25000
BOT_ENABLED=true
BOT_TICK_MS=20000

# ── Local development only ───────────────────────────────────────────────────
# Enables the one-click dev wallet at POST /api/auth/dev. Never enable in production.
DEV_LOGIN_ENABLED=false
# Set true when serving over HTTPS behind a proxy (defaults to on in production).
COOKIE_SECURE=false

# ── Optional server-wide Telegram fallback ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
